{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "H3 hex cell feature",
    "type": "object",
    "required": ["type", "properties", "geometry"],
    "additionalProperties": false,
    "properties": {
      "type": { "const": "Feature" },
      "properties": {
        "type": "object",
        "required": ["index", "centroid_lat", "centroid_lon", "resolution"],
        "additionalProperties": false,
        "properties": {
          "index":        { "type": "string", "pattern": "^[0-9a-f]{15}$" },
          "centroid_lat": { "type": "number", "minimum": -90,  "maximum": 90 },
          "centroid_lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "resolution":   { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      },
      "geometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "const": "Polygon" },
          "coordinates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90,  "maximum": 90 }
                ]
              }
            }
          }
        }
      }
    }
  }